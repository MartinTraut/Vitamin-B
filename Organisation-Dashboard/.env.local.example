# Supabase-Anbindung für das geteilte Team-Dashboard.
# Diese Datei nach ".env.local" kopieren und die Werte aus deinem
# Supabase-Projekt (Settings → API) eintragen. OHNE diese Werte läuft
# das Dashboard im lokalen Demo-Modus (Daten nur im Browser, kein Login).

NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=DEIN-ANON-PUBLIC-KEY

# E-Mail des geteilten Team-Accounts (in Supabase → Authentication → Users anlegen).
# Das Passwort dazu ist euer Team-Passwort und wird NICHT hier gespeichert.
NEXT_PUBLIC_TEAM_EMAIL=team@vitaminb-os.de
